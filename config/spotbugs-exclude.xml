<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Lombok genera código que SpotBugs interpreta mal -->
    <Match>
        <Source name="~.*\.java"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Spring inyecta campos por reflexión, no es un bug real -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD,NP_UNWRITTEN_FIELD"/>
    </Match>

    <!-- DTOs y entidades generalmente no necesitan serialVersionUID -->
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>

    <!-- \n en text blocks de HTML es intencional; %n no aplica para contenido HTML -->
    <Match>
        <Class name="com.signasource.signa_api.auth.service.EmailService"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

</FindBugsFilter>
