// signa-api application metrics (business counters, JVM, HikariCP, HTTP latency histograms,
// R2 probe, client telemetry). job="signa-api" — the perf dashboard's PromQL relies on these names.
prometheus.scrape "signa_api" {
  targets = [{
    __address__ = "signa-api:8080",
    job         = "signa-api",
  }]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// Host CPU / memory / disk / network of the droplet.
prometheus.scrape "node_exporter" {
  targets = [{
    __address__ = "node-exporter:9100",
    job         = "node-exporter",
  }]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// Per-container resource usage.
prometheus.scrape "cadvisor" {
  targets = [{
    __address__ = "cadvisor:8080",
    job         = "cadvisor",
  }]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// PostgreSQL internals.
prometheus.scrape "postgres_exporter" {
  targets = [{
    __address__ = "postgres-exporter:9187",
    job         = "postgres-exporter",
  }]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push"

    basic_auth {
      username = "3658481"
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
